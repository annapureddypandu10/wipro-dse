 11
Write a program that prompts the user for a CHOICE.
If CHOICE=1 display employees earning more than 2000.
Else display employees earning less than 2000.
Use REF CURSOR.
====================================================================

SQL Command:
------------

sql> ACCEPT P_CHOICE PROMPT 'Enter Choice (1/2) : '

sql> DECLARE

TYPE EMP_CURSOR IS REF CURSOR;

C1 EMP_CURSOR;

V_EMPNO EMP.EMPNO%TYPE;
V_ENAME EMP.ENAME%TYPE;
V_SAL EMP.SAL%TYPE;

BEGIN

IF &P_CHOICE=1 THEN

OPEN C1 FOR
SELECT EMPNO,ENAME,SAL
FROM EMP
WHERE SAL>2000;

ELSE

OPEN C1 FOR
SELECT EMPNO,ENAME,SAL
FROM EMP
WHERE SAL<2000;

END IF;

LOOP

FETCH C1
INTO V_EMPNO,V_ENAME,V_SAL;

EXIT WHEN C1%NOTFOUND;

DBMS_OUTPUT.PUT_LINE
(V_EMPNO||' '||
V_ENAME||' '||
V_SAL);

END LOOP;

CLOSE C1;

END;
/

