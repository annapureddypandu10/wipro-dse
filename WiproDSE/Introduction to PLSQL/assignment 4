 10
Display the DEPT record by passing DEPTNO.
Increase salary of employees:
DEPTNO 10 -> 15%
DEPTNO 20 -> 15%
Others    -> 5%
Also display the employees working in that department.
Use Parameter Cursor, FOR LOOP and FOR UPDATE clause.
====================================================================

SQL Command:
------------

sql> ACCEPT P_DEPT PROMPT 'Enter Department Number : '

sql> DECLARE

V_DEPT DEPT%ROWTYPE;

CURSOR C1(PNO NUMBER) IS
SELECT *
FROM EMP
WHERE DEPTNO=PNO
FOR UPDATE;

BEGIN

SELECT *
INTO V_DEPT
FROM DEPT
WHERE DEPTNO=&P_DEPT;

DBMS_OUTPUT.PUT_LINE('Department No : '||V_DEPT.DEPTNO);
DBMS_OUTPUT.PUT_LINE('Department    : '||V_DEPT.DNAME);
DBMS_OUTPUT.PUT_LINE('Location      : '||V_DEPT.LOC);

FOR R IN C1(&P_DEPT)
LOOP

IF &P_DEPT=10 THEN

UPDATE EMP
SET SAL=SAL*1.15
WHERE CURRENT OF C1;

ELSIF &P_DEPT=20 THEN

UPDATE EMP
SET SAL=SAL*1.15
WHERE CURRENT OF C1;

ELSE

UPDATE EMP
SET SAL=SAL*1.05
WHERE CURRENT OF C1;

END IF;

DBMS_OUTPUT.PUT_LINE
(R.EMPNO||' '||
R.ENAME||' '||
R.JOB);

END LOOP;

COMMIT;

END;
/

Output:
-------

Enter Department Number : 10

Department No : 10
Department    : ACCOUNTING
Location      : NEW YORK

7782 CLARK MANAGER
7839 KING PRESIDENT
7934 MILLER CLERK

PL/SQL procedure successfully completed.


