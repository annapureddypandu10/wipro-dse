 8
Create a Parameter Cursor that takes DEPTNO as parameter and
updates STAR column with '*'.
Each '*' represents 1000 salary.
Use Parameter Cursor, FOR LOOP and WHERE CURRENT OF.
====================================================================

Prerequisite:
-------------

sql> ALTER TABLE EMP
     ADD STAR VARCHAR2(10);

Output:
-------

Table altered.


SQL Command:
------------

sql> ACCEPT P_DEPT PROMPT 'Enter Department Number : '

sql> DECLARE

CURSOR C1(PNO NUMBER) IS
SELECT ROWID RID,SAL
FROM EMP
WHERE DEPTNO=PNO
FOR UPDATE;

BEGIN

FOR R IN C1(&P_DEPT)
LOOP

UPDATE EMP
SET STAR=RPAD('*',TRUNC(R.SAL/1000),'*')
WHERE CURRENT OF C1;

END LOOP;

COMMIT;

END;
/

