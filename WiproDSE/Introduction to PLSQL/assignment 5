 1
Create a table MESSAGES with a column RESULT of type
VARCHAR2(1000).

Write a PL/SQL program that prompts for SAL and gets the
corresponding ENAME from EMP table.
Do not use Explicit Cursors.

If one row is returned      -> Insert ENAME||' '||SAL
If more than one row        -> Insert 'More than one employee with salary <>'
If no row is returned       -> Insert 'No Employee with salary <>'
Any other error             -> Insert 'Other Error'

Use Named Exception Handlers.
====================================================================

Create Table:
-------------

sql> CREATE TABLE MESSAGES
     (
         RESULT VARCHAR2(1000)
     );

Output:
-------

Table created.


PL/SQL Program:
---------------

sql> SET SERVEROUTPUT ON;

sql> ACCEPT P_SAL PROMPT 'Enter Salary : '

sql> DECLARE

V_ENAME EMP.ENAME%TYPE;

BEGIN

SELECT ENAME
INTO V_ENAME
FROM EMP
WHERE SAL=&P_SAL;

INSERT INTO MESSAGES
VALUES(V_ENAME||' '||&P_SAL);

EXCEPTION

WHEN TOO_MANY_ROWS THEN

INSERT INTO MESSAGES
VALUES('More than one employee with salary '||&P_SAL);

WHEN NO_DATA_FOUND THEN

INSERT INTO MESSAGES
VALUES('No Employee with salary '||&P_SAL);

WHEN OTHERS THEN

INSERT INTO MESSAGES
VALUES('Other Error');

END;
/

Output (Salary = 3000):
-----------------------

PL/SQL procedure successfully completed.


Verify:
-------

sql> SELECT * FROM MESSAGES;

RESULT
------------------------------------------
More than one employee with salary 3000


Output (Salary = 5000):
-----------------------

RESULT
------------------------------------------
KING 5000


Output (Salary = 7000):
-----------------------

RESULT
------------------------------------------
No Employee with salary 7000


