 4
Create STOCK table with columns:
PNO, PNAME, RATE, TR_QTY

Insert records.

Write a PL/SQL block that accepts
PNO, TR_TYPE and TR_QTY.

TR_TYPE='R'
Update Quantity = Old Qty + New Qty

TR_TYPE='I'
Update Quantity = Old Qty - New Qty

Handle User Defined Exceptions.
====================================================================

Create Table:
-------------

sql> CREATE TABLE STOCK
(
PNO NUMBER PRIMARY KEY,
PNAME VARCHAR2(30),
RATE NUMBER(8,2),
TR_QTY NUMBER
);

Output:
-------

Table created.


Insert Records:
---------------

sql> INSERT INTO STOCK VALUES(101,'MOUSE',500,50);
sql> INSERT INTO STOCK VALUES(102,'KEYBOARD',800,40);
sql> INSERT INTO STOCK VALUES(103,'MONITOR',12000,15);

sql> COMMIT;

Output:
-------

Commit complete.


PL/SQL Program:
---------------

sql> ACCEPT P_PNO PROMPT 'Enter Product Number : '
sql> ACCEPT P_TYPE PROMPT 'Enter Transaction Type (R/I) : '
sql> ACCEPT P_QTY PROMPT 'Enter Transaction Quantity : '

sql> DECLARE

INVALID_PRODUCT EXCEPTION;
INVALID_TYPE EXCEPTION;

V_COUNT NUMBER;

BEGIN

SELECT COUNT(*)
INTO V_COUNT
FROM STOCK
WHERE PNO=&P_PNO;

IF V_COUNT=0 THEN
RAISE INVALID_PRODUCT;
END IF;

IF UPPER('&P_TYPE')='R' THEN

UPDATE STOCK
SET TR_QTY=TR_QTY+&P_QTY
WHERE PNO=&P_PNO;

ELSIF UPPER('&P_TYPE')='I' THEN

UPDATE STOCK
SET TR_QTY=TR_QTY-&P_QTY
WHERE PNO=&P_PNO;

ELSE

RAISE INVALID_TYPE;

END IF;

COMMIT;

DBMS_OUTPUT.PUT_LINE
('Stock Updated Successfully.');

EXCEPTION

WHEN INVALID_PRODUCT THEN

DBMS_OUTPUT.PUT_LINE
('Invalid Product Number.');

WHEN INVALID_TYPE THEN

DBMS_OUTPUT.PUT_LINE
('Invalid Transaction Type.');

END;
/

Output:
-------

Enter Product Number : 101
Enter Transaction Type (R/I) : R
Enter Transaction Quantity : 25

Stock Updated Successfully.

PL/SQL procedure successfully completed.


Verify:
-------

sql> SELECT * FROM STOCK;

Output:
-------

PNO   PNAME      RATE     TR_QTY
----  ---------  -------  ------
101   MOUSE        500       75
102   KEYBOARD     800       40
103   MONITOR    12000       15

