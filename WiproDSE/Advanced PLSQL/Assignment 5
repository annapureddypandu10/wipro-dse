 1
Create a BEFORE Trigger that restricts the user from performing
INSERT, UPDATE and DELETE operations on EMP table between
9:00 AM and 5:00 PM.
====================================================================

SQL Command:
------------

sql> CREATE OR REPLACE TRIGGER TRG_EMP_DML
BEFORE INSERT OR UPDATE OR DELETE
ON EMP
BEGIN

IF TO_NUMBER
(
TO_CHAR(SYSDATE,'HH24')
)
BETWEEN 9 AND 17 THEN

RAISE_APPLICATION_ERROR
(
-20001,
'DML Operations are not allowed between 09:00 AM and 05:00 PM.'
);

END IF;

END;
/

Output:
-------

Trigger created.


