 3
Create a Complex View V3 containing:

EMPNO, ENAME, JOB, SAL,
EMP.DEPTNO, DNAME, LOC

from EMP and DEPT tables.

Create an INSTEAD OF Trigger for INSERT or UPDATE on V3.

Requirements:
--------------
1. If DEPTNO does not exist in DEPT table,
   INSERT the department.

2. Otherwise UPDATE DNAME and LOC.

3. If EMPNO does not exist in EMP table,
   INSERT EMPNO, ENAME, JOB, SAL and DEPTNO.

4. Otherwise UPDATE ENAME, JOB, SAL and DEPTNO.
====================================================================

====================================================================
Step 1 : Create Complex View V3
====================================================================

SQL Command:
------------

sql> CREATE OR REPLACE VIEW V3
AS
SELECT
E.EMPNO,
E.ENAME,
E.JOB,
E.SAL,
E.DEPTNO,
D.DNAME,
D.LOC
FROM EMP E,
     DEPT D
WHERE E.DEPTNO=D.DEPTNO;

Output:
-------

View created.


====================================================================
Step 2 : Create INSTEAD OF Trigger
====================================================================

SQL Command:
------------

sql> CREATE OR REPLACE TRIGGER TRG_V3
INSTEAD OF INSERT OR UPDATE
ON V3

DECLARE

V_COUNT NUMBER;

BEGIN

------------------------------------------------------------
-- Check Department
------------------------------------------------------------

SELECT COUNT(*)
INTO V_COUNT
FROM DEPT
WHERE DEPTNO=:NEW.DEPTNO;

IF V_COUNT=0 THEN

INSERT INTO DEPT
(
DEPTNO,
DNAME,
LOC
)
VALUES
(
:NEW.DEPTNO,
:NEW.DNAME,
:NEW.LOC
);

ELSE

UPDATE DEPT
SET DNAME=:NEW.DNAME,
LOC=:NEW.LOC
WHERE DEPTNO=:NEW.DEPTNO;

END IF;

------------------------------------------------------------
-- Check Employee
------------------------------------------------------------

SELECT COUNT(*)
INTO V_COUNT
FROM EMP
WHERE EMPNO=:NEW.EMPNO;

IF V_COUNT=0 THEN

INSERT INTO EMP
(
EMPNO,
ENAME,
JOB,
SAL,
DEPTNO
)
VALUES
(
:NEW.EMPNO,
:NEW.ENAME,
:NEW.JOB,
:NEW.SAL,
:NEW.DEPTNO
);

ELSE

UPDATE EMP
SET ENAME=:NEW.ENAME,
JOB=:NEW.JOB,
SAL=:NEW.SAL,
DEPTNO=:NEW.DEPTNO
WHERE EMPNO=:NEW.EMPNO;

END IF;

END;
/

Output:
-------

Trigger created.


