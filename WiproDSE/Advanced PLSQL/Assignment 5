 2
Create AUDIT_EMP table.

Create a Trigger that performs auditing.

1. INSERT  -> EMPNO, USERNAME, DATE, 'I'
2. UPDATE  -> OLD EMPNO, USERNAME, DATE, 'U'
3. DELETE  -> OLD EMPNO, USERNAME, DATE, 'D'

Use:
• AUTONOMOUS TRANSACTION
• INSERTING
• UPDATING
• DELETING
====================================================================

Step 1 : Create Audit Table
---------------------------

sql> CREATE TABLE AUDIT_EMP
(
EMPNO NUMBER,
USERNAME VARCHAR2(30),
TRDATE DATE,
TRTYPE CHAR(1)
);

Output:
-------

Table created.


====================================================================
Step 2 : Create Trigger
====================================================================

sql> CREATE OR REPLACE TRIGGER TRG_AUDIT_EMP
AFTER INSERT OR UPDATE OR DELETE
ON EMP

DECLARE

PRAGMA AUTONOMOUS_TRANSACTION;

BEGIN

IF INSERTING THEN

INSERT INTO AUDIT_EMP
VALUES
(
:NEW.EMPNO,
USER,
SYSDATE,
'I'
);

ELSIF UPDATING THEN

INSERT INTO AUDIT_EMP
VALUES
(
:OLD.EMPNO,
USER,
SYSDATE,
'U'
);

ELSIF DELETING THEN

INSERT INTO AUDIT_EMP
VALUES
(
:OLD.EMPNO,
USER,
SYSDATE,
'D'
);

END IF;

COMMIT;

END;
/

Output:
-------

Trigger created.


