 1
Create a Procedure ADD_DEPT.
This procedure takes three IN parameters:
DEPTNO, DNAME and LOC.
Insert these values into DEPT table.
Handle duplicate DEPTNO using User Defined Exception.
====================================================================

SQL Command:
------------

sql> SET SERVEROUTPUT ON;

sql> CREATE OR REPLACE PROCEDURE ADD_DEPT
(
P_DEPTNO IN DEPT.DEPTNO%TYPE,
P_DNAME  IN DEPT.DNAME%TYPE,
P_LOC    IN DEPT.LOC%TYPE
)
IS

DUP_DEPT EXCEPTION;
V_COUNT NUMBER;

BEGIN

SELECT COUNT(*)
INTO V_COUNT
FROM DEPT
WHERE DEPTNO=P_DEPTNO;

IF V_COUNT>0 THEN
RAISE DUP_DEPT;
END IF;

INSERT INTO DEPT
VALUES(P_DEPTNO,P_DNAME,P_LOC);

COMMIT;

DBMS_OUTPUT.PUT_LINE('Department Inserted Successfully.');

EXCEPTION

WHEN DUP_DEPT THEN
DBMS_OUTPUT.PUT_LINE('Duplicate Department Number.');

END;
/

Output:
-------

Procedure created.


Execute:
--------

sql> EXEC ADD_DEPT(50,'HR','HYDERABAD');

Output:
-------

Department Inserted Successfully.

PL/SQL procedure successfully completed.


