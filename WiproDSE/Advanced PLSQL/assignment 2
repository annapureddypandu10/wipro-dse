 2
Create a Procedure UPDATE_DEPT.
Update DNAME and LOC for the given DEPTNO.
Handle exception when DEPTNO does not exist.
====================================================================

SQL Command:
------------

sql> CREATE OR REPLACE PROCEDURE UPDATE_DEPT
(
P_DEPTNO IN DEPT.DEPTNO%TYPE,
P_DNAME  IN DEPT.DNAME%TYPE,
P_LOC    IN DEPT.LOC%TYPE
)
IS

INVALID_DEPT EXCEPTION;

BEGIN

UPDATE DEPT
SET DNAME=P_DNAME,
LOC=P_LOC
WHERE DEPTNO=P_DEPTNO;

IF SQL%ROWCOUNT=0 THEN
RAISE INVALID_DEPT;
END IF;

COMMIT;

DBMS_OUTPUT.PUT_LINE('Department Updated.');

EXCEPTION

WHEN INVALID_DEPT THEN

DBMS_OUTPUT.PUT_LINE('Department Number Not Found.');

END;
/

Output:
-------

Procedure created.


Execute:
--------

sql> EXEC UPDATE_DEPT(50,'FINANCE','MUMBAI');

Output:
-------

Department Updated.

PL/SQL procedure successfully completed.


