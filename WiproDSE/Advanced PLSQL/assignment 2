(
     P_DEPTNO NUMBER
)
IS

CURSOR C1(PNO NUMBER) IS
SELECT *
FROM EMP
WHERE DEPTNO=PNO
FOR UPDATE;

BEGIN

FOR R IN C1(P_DEPTNO)
LOOP

INSERT INTO TEST
VALUES
(
R.EMPNO,
R.ENAME,
R.JOB,
R.MGR,
R.HIREDATE,
R.SAL,
R.COMM,
R.DEPTNO
);

