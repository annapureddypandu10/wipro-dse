 7
Create a Procedure that inserts employees of a given DEPTNO into
EMP_TEST table and updates their salary by 20% in EMP table.

Use:
• Parameter Cursor
• FOR LOOP Cursor
• FOR UPDATE clause
====================================================================

Create EMP_TEST
---------------

sql> CREATE TABLE EMP_TEST
AS
SELECT *
FROM EMP
WHERE 1=2;

Output:
-------

Table created.


Procedure
---------

sql> CREATE OR REPLACE PROCEDURE COPY_UPDATE_EMP
(
P_DEPTNO NUMBER
)
IS

CURSOR C1(PNO NUMBER)
IS
SELECT *
FROM EMP
WHERE DEPTNO=PNO
FOR UPDATE;

BEGIN

FOR R IN C1(P_DEPTNO)
LOOP

INSERT INTO EMP_TEST
VALUES
(
R.EMPNO,
R.ENAME,
R.JOB,
R.MGR,
R.HIREDATE,
R.SAL,
R.COMM,
R.DEPTNO
);

UPDATE EMP
SET SAL=SAL*1.20
WHERE CURRENT OF C1;

END LOOP;

COMMIT;

DBMS_OUTPUT.PUT_LINE
('Employees Copied and Salary Updated.');

END;
/

