 5
Create a Function CAL_PCT that calculates an employee salary
based on the given percentage.
Pass EMPNO and percentage.
Use 16% as the default percentage.
====================================================================

SQL Command:
------------

sql> CREATE OR REPLACE FUNCTION CAL_PCT
(
     P_EMPNO NUMBER,
     P_PERCENT NUMBER DEFAULT 16
)
RETURN NUMBER
IS

     V_SAL EMP.SAL%TYPE;

BEGIN

     SELECT SAL
     INTO V_SAL
     FROM EMP
     WHERE EMPNO=P_EMPNO;

     RETURN V_SAL+(V_SAL*P_PERCENT/100);

EXCEPTION

     WHEN NO_DATA_FOUND THEN
          RETURN NULL;

END;
/

