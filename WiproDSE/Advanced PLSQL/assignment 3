 6
Create a Function that returns TRUE if the salary is less than
the average salary; otherwise FALSE.

Create a Procedure REC_INSUPD that inserts/updates an employee
only if the new salary is less than the average salary.
====================================================================

Step 1 : Create Function
------------------------

sql> CREATE OR REPLACE FUNCTION CHECK_SAL
(
     P_SAL NUMBER
)
RETURN BOOLEAN
IS

     V_AVG NUMBER;

BEGIN

     SELECT AVG(SAL)
     INTO V_AVG
     FROM EMP;

     IF P_SAL<V_AVG THEN
          RETURN TRUE;
     ELSE
          RETURN FALSE;
     END IF;

END;
/

Output:
-------

Function created.


Step 2 : Create Procedure
-------------------------

sql> CREATE OR REPLACE PROCEDURE REC_INSUPD
(
     P_EMPNO NUMBER,
     P_ENAME VARCHAR2,
     P_SAL NUMBER
)
IS

     V_COUNT NUMBER;

BEGIN

     IF CHECK_SAL(P_SAL) THEN

          SELECT COUNT(*)
          INTO V_COUNT
          FROM EMP
          WHERE EMPNO=P_EMPNO;

          IF V_COUNT=0 THEN

               INSERT INTO EMP
               (EMPNO,ENAME,SAL)
               VALUES
               (P_EMPNO,P_ENAME,P_SAL);

               DBMS_OUTPUT.PUT_LINE
               ('Employee Inserted.');

          ELSE

               UPDATE EMP
               SET ENAME=P_ENAME,
                   SAL=P_SAL
               WHERE EMPNO=P_EMPNO;

               DBMS_OUTPUT.PUT_LINE
               ('Employee Updated.');

          END IF;

          COMMIT;

     ELSE

          DBMS_OUTPUT.PUT_LINE
          ('Salary is greater than Average Salary.');

     END IF;

END;
/

