 3
Assume EMP and DEPT have no relationship.

Create a Function VALID_DEPTNO that returns TRUE if the given
DEPTNO exists.

Create a Procedure ADD_EMP that inserts EMPNO, ENAME, SAL and
DEPTNO into EMP only if VALID_DEPTNO returns TRUE.
Otherwise display an error message.
====================================================================

Step 1 : Function VALID_DEPTNO
------------------------------

sql> CREATE OR REPLACE FUNCTION VALID_DEPTNO
(
     P_DEPTNO NUMBER
)
RETURN BOOLEAN
IS

V_COUNT NUMBER;

BEGIN

SELECT COUNT(*)
INTO V_COUNT
FROM DEPT
WHERE DEPTNO=P_DEPTNO;

IF V_COUNT>0 THEN
     RETURN TRUE;
ELSE
     RETURN FALSE;
END IF;

END;
/

Output:
-------

Function created.


Step 2 : Procedure ADD_EMP
--------------------------

sql> CREATE OR REPLACE PROCEDURE ADD_EMP
(
     P_EMPNO NUMBER,
     P_ENAME VARCHAR2,
     P_SAL NUMBER,
     P_DEPTNO NUMBER
)
IS
BEGIN

IF VALID_DEPTNO(P_DEPTNO) THEN

     INSERT INTO EMP
     (EMPNO,ENAME,SAL,DEPTNO)
     VALUES
     (P_EMPNO,P_ENAME,P_SAL,P_DEPTNO);

     COMMIT;

     DBMS_OUTPUT.PUT_LINE
     ('Employee Inserted.');

ELSE

     DBMS_OUTPUT.PUT_LINE
     ('Invalid Department Number.');

END IF;

EXCEPTION

WHEN DUP_VAL_ON_INDEX THEN

     DBMS_OUTPUT.PUT_LINE
     ('Duplicate Employee Number.');

WHEN OTHERS THEN

     DBMS_OUTPUT.PUT_LINE(SQLERRM);

END;
/

