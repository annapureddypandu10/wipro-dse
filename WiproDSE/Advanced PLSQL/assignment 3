 7
Create a Function CAL_LDATE that returns the employee's joining
date in the format:
DAY, MONTH DD, YYYY
Return the date in GERMAN language.
====================================================================

SQL Command:
------------

sql> CREATE OR REPLACE FUNCTION CAL_LDATE
(
     P_EMPNO NUMBER
)
RETURN VARCHAR2
IS

     V_HDATE DATE;

BEGIN

     SELECT HIREDATE
     INTO V_HDATE
     FROM EMP
     WHERE EMPNO=P_EMPNO;

     RETURN TO_CHAR
     (
          V_HDATE,
          'DAY, MONTH DD, YYYY',
          'NLS_DATE_LANGUAGE=GERMAN'
     );

EXCEPTION

     WHEN NO_DATA_FOUND THEN
          RETURN 'EMPLOYEE NOT FOUND';

END;
/

Output:
-------

Function created.


Execute:
--------

sql> SELECT CAL_LDATE(7788) AS JOIN_DATE
     FROM DUAL;

Output:
-------

JOIN_DATE
-----------------------------------------
SAMSTAG, APRIL 19, 1987


