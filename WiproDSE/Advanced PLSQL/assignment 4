====================================================================
 2
Create a Package PK2 that contains two procedures:

1. DISP_FIRST3
   - Displays the first 3 employees from EMP table.

2. DISP_FIRST6
   - Displays the first 6 employees from EMP table.

Use one Global Cursor in the Package.
====================================================================

Step 1 : Package Specification
------------------------------

sql> SET SERVEROUTPUT ON;

sql> CREATE OR REPLACE PACKAGE PK2
IS

PROCEDURE DISP_FIRST3;

PROCEDURE DISP_FIRST6;

END PK2;
/

Output:
-------

Package created.


====================================================================
Step 2 : Package Body
====================================================================

sql> CREATE OR REPLACE PACKAGE BODY PK2
IS

------------------------------------------------------------------
-- Global Cursor
------------------------------------------------------------------

CURSOR C1 IS
SELECT EMPNO,
       ENAME,
       JOB,
       SAL
FROM EMP
ORDER BY EMPNO;

------------------------------------------------------------------
-- Procedure DISP_FIRST3
------------------------------------------------------------------

PROCEDURE DISP_FIRST3
IS

V_REC C1%ROWTYPE;
V_COUNT NUMBER:=0;

BEGIN

OPEN C1;

LOOP

FETCH C1 INTO V_REC;

EXIT WHEN C1%NOTFOUND OR V_COUNT=3;

DBMS_OUTPUT.PUT_LINE
(
V_REC.EMPNO||'  '||
V_REC.ENAME||'  '||
V_REC.JOB||'  '||
V_REC.SAL
);

V_COUNT:=V_COUNT+1;

END LOOP;

CLOSE C1;

END DISP_FIRST3;

------------------------------------------------------------------
-- Procedure DISP_FIRST6
------------------------------------------------------------------

PROCEDURE DISP_FIRST6
IS

V_REC C1%ROWTYPE;
V_COUNT NUMBER:=0;

BEGIN

OPEN C1;

LOOP

FETCH C1 INTO V_REC;

EXIT WHEN C1%NOTFOUND OR V_COUNT=6;

DBMS_OUTPUT.PUT_LINE
(
V_REC.EMPNO||'  '||
V_REC.ENAME||'  '||
V_REC.JOB||'  '||
V_REC.SAL
);

V_COUNT:=V_COUNT+1;

END LOOP;

CLOSE C1;

END DISP_FIRST6;

END PK2;
/

