====================================================================
3
Create a Sequence S2 starting with 1 and increment by 1.

Create a Package PK3 with two overloaded procedures ADD_EMP.

Procedure 1:
-------------
Accepts:
EMPNO,
ENAME DEFAULT 'UNK',
SAL DEFAULT 1000

Insert the values into EMP table.

Procedure 2:
-------------
Accepts:
ENAME DEFAULT 'UNK',
SAL DEFAULT 1000

Generate EMPNO using Sequence S2 and insert the values into
EMP table.
====================================================================

====================================================================
Step 1 : Create Sequence S2
====================================================================

SQL Command:
------------

sql> CREATE SEQUENCE S2
     START WITH 1
     INCREMENT BY 1;

Output:
-------

Sequence created.


====================================================================
Step 2 : Package Specification
====================================================================

sql> CREATE OR REPLACE PACKAGE PK3
IS

PROCEDURE ADD_EMP
(
EMPNO NUMBER,
ENAME VARCHAR2 DEFAULT 'UNK',
SAL NUMBER DEFAULT 1000
);

PROCEDURE ADD_EMP
(
ENAME VARCHAR2 DEFAULT 'UNK',
SAL NUMBER DEFAULT 1000
);

END PK3;
/

Output:
-------

Package created.


====================================================================
Step 3 : Package Body
====================================================================

sql> CREATE OR REPLACE PACKAGE BODY PK3
IS

------------------------------------------------------------------
-- Procedure 1
------------------------------------------------------------------

PROCEDURE ADD_EMP
(
EMPNO NUMBER,
ENAME VARCHAR2 DEFAULT 'UNK',
SAL NUMBER DEFAULT 1000
)
IS
BEGIN

INSERT INTO EMP
(
EMPNO,
ENAME,
SAL
)
VALUES
(
EMPNO,
ENAME,
SAL
);

COMMIT;

DBMS_OUTPUT.PUT_LINE
('Employee Inserted.');

EXCEPTION

WHEN DUP_VAL_ON_INDEX THEN

DBMS_OUTPUT.PUT_LINE
('Duplicate Employee Number.');

WHEN OTHERS THEN

DBMS_OUTPUT.PUT_LINE(SQLERRM);

END ADD_EMP;

------------------------------------------------------------------
-- Procedure 2
------------------------------------------------------------------

PROCEDURE ADD_EMP
(
ENAME VARCHAR2 DEFAULT 'UNK',
SAL NUMBER DEFAULT 1000
)
IS

V_EMPNO NUMBER;

BEGIN

SELECT S2.NEXTVAL
INTO V_EMPNO
FROM DUAL;

INSERT INTO EMP
(
EMPNO,
ENAME,
SAL
)
VALUES
(
V_EMPNO,
ENAME,
SAL
);

COMMIT;

DBMS_OUTPUT.PUT_LINE
('Employee Inserted. EMPNO = '||V_EMPNO);

EXCEPTION

WHEN OTHERS THEN

DBMS_OUTPUT.PUT_LINE(SQLERRM);

END ADD_EMP;

END PK3;
/

