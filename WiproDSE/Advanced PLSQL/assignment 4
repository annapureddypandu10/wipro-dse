====================================================================
 1
Create Package PK1 with the following:

1. Procedure ADD_DEPT
2. Procedure UPDATE_DEPT
3. Procedure DELETE_DEPT
4. Local Function CAL_CNT

Use CAL_CNT in all the procedures.

Create a One-Time Procedure to display the total number
of departments.
====================================================================

Step 1 : Package Specification
------------------------------

sql> CREATE OR REPLACE PACKAGE PK1
IS

PROCEDURE ADD_DEPT
(
DNO NUMBER,
NAME VARCHAR2,
LO VARCHAR2
);

PROCEDURE UPDATE_DEPT
(
DNO NUMBER,
NAME VARCHAR2,
LO VARCHAR2
);

PROCEDURE DELETE_DEPT
(
DNO NUMBER
);

END PK1;
/

Output:
-------

Package created.


====================================================================
Step 2 : Package Body
====================================================================

sql> CREATE OR REPLACE PACKAGE BODY PK1
IS

------------------------------------------------------------------
-- Local Function
------------------------------------------------------------------

FUNCTION CAL_CNT
(
P_DEPTNO NUMBER
)
RETURN BOOLEAN
IS

V_COUNT NUMBER;

BEGIN

SELECT COUNT(*)
INTO V_COUNT
FROM DEPT
WHERE DEPTNO=P_DEPTNO;

IF V_COUNT=0 THEN
RETURN TRUE;
ELSE
RETURN FALSE;
END IF;

END CAL_CNT;

------------------------------------------------------------------
-- Procedure ADD_DEPT
------------------------------------------------------------------

PROCEDURE ADD_DEPT
(
DNO NUMBER,
NAME VARCHAR2,
LO VARCHAR2
)
IS
BEGIN

IF CAL_CNT(DNO) THEN

INSERT INTO DEPT
VALUES(DNO,NAME,LO);

COMMIT;

DBMS_OUTPUT.PUT_LINE
('Department Inserted.');

ELSE

DBMS_OUTPUT.PUT_LINE
('Duplicate Department Number.');

END IF;

END ADD_DEPT;

------------------------------------------------------------------
-- Procedure UPDATE_DEPT
------------------------------------------------------------------

PROCEDURE UPDATE_DEPT
(
DNO NUMBER,
NAME VARCHAR2,
LO VARCHAR2
)
IS
BEGIN

IF NOT CAL_CNT(DNO) THEN

UPDATE DEPT
SET DNAME=NAME,
LOC=LO
WHERE DEPTNO=DNO;

COMMIT;

DBMS_OUTPUT.PUT_LINE
('Department Updated.');

ELSE

DBMS_OUTPUT.PUT_LINE
('Department Number Not Found.');

END IF;

END UPDATE_DEPT;

------------------------------------------------------------------
-- Procedure DELETE_DEPT
------------------------------------------------------------------

PROCEDURE DELETE_DEPT
(
DNO NUMBER
)
IS
BEGIN

IF NOT CAL_CNT(DNO) THEN

DELETE FROM DEPT
WHERE DEPTNO=DNO;

COMMIT;

DBMS_OUTPUT.PUT_LINE
('Department Deleted.');

ELSE

DBMS_OUTPUT.PUT_LINE
('Department Number Not Found.');

END IF;

END DELETE_DEPT;

END PK1;
/

Output:
-------

Package body created.


====================================================================
Step 3 : One-Time Procedure
Display Total Number of Departments
====================================================================

sql> CREATE OR REPLACE PROCEDURE DISP_DEPT_COUNT
IS

V_COUNT NUMBER;

BEGIN

SELECT COUNT(*)
INTO V_COUNT
FROM DEPT;

DBMS_OUTPUT.PUT_LINE
('Total Departments = '||V_COUNT);

END;
/

